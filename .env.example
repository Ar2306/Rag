# Required for answer generation, contextual enrichment, summaries and the knowledge graph.
# Retrieval (upload → hybrid search) works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# ATLAS_ANSWER_MODEL=claude-opus-5
# ATLAS_ANSWER_EFFORT=low
# ATLAS_CONTEXT_MODEL=claude-haiku-4-5
# ATLAS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# ATLAS_EMBED_DIM=384
# ATLAS_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# ATLAS_TOP_K=8
