# Any OpenAI-compatible provider. Retrieval (upload → hybrid search) works with none.
# Enrichment, summaries, knowledge graph and answers need one.
#   gemini | ollama-cloud | ollama | groq | openrouter | mistral | cerebras | deepseek | xai | openai
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional overrides (defaults per provider in atlas/config.py)
# LLM_MODEL=gemini-2.5-pro          # answers
# LLM_FAST_MODEL=gemini-2.5-flash   # enrichment, summaries, follow-up rewrites
# LLM_BASE_URL=                     # only for a provider not in the list
# ATLAS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# ATLAS_EMBED_DIM=384
# ATLAS_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# ATLAS_TOP_K=8
# ATLAS_RERANK_POOL=40
# ATLAS_CONTEXT_CONCURRENCY=4
